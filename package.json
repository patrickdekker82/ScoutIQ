{
  "name": "scoutiq",
  "version": "0.2.0",
  "private": true,
  "description": "ScoutIQ - self-hosted football scouting & analytics platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx jobs/worker-main.ts",
    "scheduler": "tsx jobs/scheduler-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:sql": "tsx scripts/apply-sql-objects.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:verify": "bash scripts/db-verify.sh",
    "db:export": "tsx scripts/db-export.ts",
    "ingest:statsbomb": "tsx scripts/ingest.ts statsbomb",
    "ingest:skillcorner": "tsx scripts/ingest.ts skillcorner",
    "ingest:metrica": "tsx scripts/ingest.ts metrica",
    "ingest:csv": "tsx scripts/ingest.ts csv",
    "analytics:refresh": "tsx scripts/analytics-refresh.ts",
    "storage:init": "tsx scripts/storage-init.ts",
    "postinstall": "prisma generate",
    "ingest:demo": "tsx scripts/ingest.ts demo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.81.0",
    "ioredis": "^5.11.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "prisma": "^6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
