###############################################################################
# ScoutIQ - example environment
#
#   cp .env.example .env
#
# NEVER commit a real .env. Everything environment-specific lives here, so the
# same images run on the Hyper-V Debian VM, a bare-metal server, a VPS or a
# cloud VPS with nothing but a different file.
###############################################################################

NODE_ENV=production
LOG_LEVEL=info

# Public URL of this deployment. LAN-only is fine: http://scoutiq.local
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
HTTP_HOST=0.0.0.0

# --- Database (§7, §8) -------------------------------------------------------
# PostgreSQL is ScoutIQ's canonical data product. Point this anywhere: the
# bundled container, a database on another machine, or a managed instance.
DATABASE_URL=postgresql://scoutiq:change-me@postgres:5432/scoutiq?schema=public
# Direct, non-pooled connection used by migrations, exports, the SQL console
# and the backup scripts. Defaults to DATABASE_URL.
DIRECT_DATABASE_URL=
# Optional read replica for analytics once the deployment spans machines.
ANALYTICS_DATABASE_URL=

REDIS_URL=redis://redis:6379

# --- Security (§62) ----------------------------------------------------------
# Generate with:  openssl rand -hex 32
# NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET=change-me-openssl-rand-hex-32
NEXTAUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
# Comma-separated origins. Empty means same-origin only.
CORS_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX=10

# --- Storage roots (§17, §69) ------------------------------------------------
# Any of these may be a local SSD, a mounted disk, a NAS mount, VPS block
# storage or an object-storage mount. The application cannot tell.
DATA_ROOT=/data
RAW_DATA_ROOT=/data/raw
NORMALIZED_DATA_ROOT=/data/normalized
PROCESSED_DATA_ROOT=/data/processed
EXPORT_ROOT=/data/exports
REPORT_ROOT=/data/reports
BACKUP_ROOT=/data/backups

# --- NAS (§18) - optional infrastructure, never required ---------------------
# Mounted inside the Debian VM (see docs/deployment/nas.md). When a path is
# unreachable ScoutIQ keeps working and only skips the archive copy.
NAS_BACKUP_PATH=
NAS_DATASET_PATH=
NAS_REPORT_PATH=
# Catch-all archive root for areas no NAS_* path names.
ARCHIVE_ROOT=
BACKUP_RETENTION_DAYS=14

# --- Open data providers (§13, §14, §15, §16) --------------------------------
# Open access is not a commercial licence: check each provider's terms before
# redistributing anything you import.
ENABLE_STATSBOMB_OPEN_DATA=true
ENABLE_SKILLCORNER_OPEN_DATA=true
ENABLE_METRICA_OPEN_DATA=true
ENABLE_DEMO_PROVIDER=true

# Point these at a local or NAS copy to import without internet access.
STATSBOMB_LOCAL_PATH=
SKILLCORNER_LOCAL_PATH=
METRICA_LOCAL_PATH=

# --- Commercial providers (§61, phase 8 of §88) ------------------------------
# Keys stay server-side and are never exposed to the browser (§62, §92).
SPORTMONKS_API_KEY=
API_FOOTBALL_KEY=
THESTATSAPI_KEY=
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_MINUTE=60

# --- Scheduling (§58) --------------------------------------------------------
# Set SCHEDULER_ENABLED=false as the first step of a migration.
SCHEDULER_ENABLED=true
PROVIDER_SYNC_CRON=0 3 * * *
ANALYTICS_CRON=30 3 * * *
MATERIALIZED_VIEW_CRON=0 4 * * *
BACKUP_CRON=0 2 * * *
CLEANUP_CRON=0 5 * * 0
# Keep this modest on 4 vCPU / 6 GB (§3, §59).
WORKER_CONCURRENCY=2

# --- Analytics ---------------------------------------------------------------
# Minimum minutes before a player enters a percentile population (§26).
ANALYTICS_MIN_MINUTES=450
CACHE_TTL_SECONDS=300

# --- Reports (§51) -----------------------------------------------------------
PDF_ENABLED=true
PDF_TIMEOUT_MS=60000
REPORT_ORGANISATION=ScoutIQ
REPORT_LOGO_PATH=
# Use a system Chromium instead of Playwright's bundled browser.
PDF_BROWSER_EXECUTABLE=

# --- SQL console (§23) -------------------------------------------------------
SQL_CONSOLE_ENABLED=true
SQL_CONSOLE_MAX_ROWS=1000
SQL_CONSOLE_TIMEOUT_MS=15000

# --- Demo mode (§73) ---------------------------------------------------------
# ScoutIQ runs with no API keys at all; demo content is labelled DEMO DATA.
DEMO_MODE=true

# --- PostgreSQL container (docker compose only) ------------------------------
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scoutiq

# --- Host bindings (docker compose only) -------------------------------------
# Where /data lands on the host. Any absolute path.
HOST_DATA_ROOT=./data
# Keep services on localhost and terminate TLS in the reverse proxy (§65).
HTTP_PUBLISH=127.0.0.1:3000
POSTGRES_PUBLISH=127.0.0.1:5432
REDIS_PUBLISH=127.0.0.1:6379
PGADMIN_PUBLISH=127.0.0.1:5050
PGADMIN_EMAIL=admin@scoutiq.local
PGADMIN_PASSWORD=change-me

# Replicas and limits (§3, §59)
API_REPLICAS=1
WORKER_REPLICAS=1
API_MEMORY_LIMIT=1G
WORKER_MEMORY_LIMIT=1G
