###############################################################################
# ScoutIQ - example environment file
#
# Copy to `.env` and adjust. NEVER commit a real `.env`.
#
#   cp .env.example .env
#
# Every environment-specific setting lives here. The application contains no
# hard-coded host paths, host names or IP addresses, so the exact same image
# runs on a Hyper-V Debian VM, a bare-metal server, a VPS or a cloud VPS.
###############################################################################

# --- Core ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Bind address. 0.0.0.0 inside a container; never a fixed LAN IP.
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Public base URL of the deployment (used for links inside generated reports).
PUBLIC_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Single source of truth for the database connection. Point it anywhere:
# the compose service, a managed PostgreSQL, or a remote host.
DATABASE_URL=postgresql://scoutiq:scoutiq@postgres:5432/scoutiq?schema=public
# Optional: separate (read-only) URL used by analytics workers when the
# deployment is split over multiple machines. Falls back to DATABASE_URL.
# ANALYTICS_DATABASE_URL=

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Storage roots ---------------------------------------------------------
# All application data lives under configurable roots. These may be a local
# SSD, a mounted disk, a NAS mount, VPS block storage or an object-storage
# mount. The application never assumes anything about the underlying device.
DATA_ROOT=/data
RAW_DATA_ROOT=/data/raw
EXPORT_ROOT=/data/exports
REPORT_ROOT=/data/reports
BACKUP_ROOT=/data/backups

# --- Backups ---------------------------------------------------------------
# Retention for local backups (days). 0 disables pruning.
BACKUP_RETENTION_DAYS=14
# Optional secondary backup target (NAS mount, second disk, object-storage
# mount, ...). Leave empty when unavailable - ScoutIQ keeps working without it.
# ARCHIVE_ROOT=/mnt/nas/scoutiq

# --- Security --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32
AUTH_TOKEN_TTL_SECONDS=86400
# Comma-separated list of allowed CORS origins. "*" only for local development.
CORS_ORIGINS=*

# --- Scheduling ------------------------------------------------------------
# Scheduled imports. Disable before a migration (see migrate-home-to-vps.md).
SCHEDULER_ENABLED=true
IMPORT_CRON=0 3 * * *
ANALYTICS_CRON=30 3 * * *
WORKER_CONCURRENCY=4

# --- Data providers --------------------------------------------------------
# Providers are pluggable and optional. The core application runs completely
# self-hosted with the built-in `local-file` provider.
# Comma-separated list of enabled providers: local-file,http-json
ENABLED_PROVIDERS=local-file
# Configuration for the http-json provider (only read when enabled).
# HTTP_JSON_PROVIDER_BASE_URL=
# HTTP_JSON_PROVIDER_API_KEY=
# Optional Playwright-based ingest service (runs in its own container).
# INGEST_SERVICE_URL=http://ingest:8000

# --- PostgreSQL container (docker-compose only) ----------------------------
# Used by the bundled `postgres` service. Ignored when you point DATABASE_URL
# at an external database.
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scoutiq
# Host port bindings. Keep them on 127.0.0.1 in production.
POSTGRES_PUBLISH=127.0.0.1:5432
REDIS_PUBLISH=127.0.0.1:6379
HTTP_PUBLISH=0.0.0.0:3000

# --- Host volume bindings (docker-compose only) ----------------------------
# Where the /data volume lands on the host. Any absolute path on any OS.
# Examples:  ./data  |  /srv/scoutiq/data  |  /mnt/blockstorage/scoutiq
HOST_DATA_ROOT=./data
