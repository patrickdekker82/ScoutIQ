# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment / secrets - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Application data (must live outside source control; see DATA_ROOT).
# The directory itself is kept so the default HOST_DATA_ROOT=./data works.
/data/*
!/data/.gitkeep

# Logs & runtime
dump.rdb
logs/
*.log
npm-debug.log*
coverage/
.vitest/

# Python (optional analytics worker)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
